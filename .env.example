# Webflow OAuth App credentials (from your app's dashboard at developers.webflow.com)
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_REDIRECT_URI=http://localhost:3000/oauth/callback

# Comma-separated scopes requested during install
WEBFLOW_SCOPES=sites:read,users:read,users:write

# Public base URL of this server (used when registering webhooks)
APP_PUBLIC_URL=http://localhost:3000

# Secret used to sign member session tokens
APP_SIGNING_SECRET=change-me-in-production

# SQLite file path (created on first run)
DATABASE_PATH=./db/membership.sqlite

# Minutes between automatic full member re-syncs (0 disables)
RECONCILE_INTERVAL_MIN=360

PORT=3000
